{
    "extends": "@tsconfig/recommended/tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "declaration": true,
        "noEmit": true,
        "types": ["node", "jest"],
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*", "test/**/*", "**/*.test.ts", "**/*.spec.ts"],
    "exclude": ["node_modules", "dist"]
}
