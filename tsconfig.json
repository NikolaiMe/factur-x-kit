{
    "extends": "@tsconfig/recommended/tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "noEmit": true,
        "types": ["node", "jest"],
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*" // Sagt TypeScript, welche Dateien in 'src' es kompilieren soll
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts", // Beispiel: Testdateien ausschließen
        "**/*.test.ts",
        "dist"
    ]
}
